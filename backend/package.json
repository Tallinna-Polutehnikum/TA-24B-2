{
  "name": "apollo-kino-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "movies:generate": "npm run build && node dist/movies/generate-movies.js",
    "db:migrate": "mikro-orm migration:up --config ./src/database/mikro-orm.config.ts",
    "db:seed": "mikro-orm seeder:run --config ./src/database/mikro-orm.config.ts",
    "db:fresh": "mikro-orm migration:fresh --seed DatabaseSeeder --config ./src/database/mikro-orm.config.ts",
    "db:baseline": "npm run build && node dist/database/baseline.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/mysql": "^6.6.17",
    "@mikro-orm/nestjs": "^6.1.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^17.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.17",
    "@mikro-orm/seeder": "^6.6.17",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts"
    ]
  }
}
